# Build artifacts
build/
*.o
*.elf
*.map
*.bin
*.hex

# Toolchain includes required runtime objects (do not ignore)
!tools/arm-gnu-toolchain/**

# OpenOCD bundle should be fully tracked (some files match patterns above, e.g. *.hex)
!tools/openocd/**

# IDE / Editor
.idea/
*.swp
.DS_Store

# Backup / logs
*.log
*.bak

# Optional: Ignore local OpenOCD binary history (use LFS instead)
